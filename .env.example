# Punar service configuration.
# Copy to .env and fill in. Never commit the filled-in file.

# --- Webhook authentication (REQUIRED in any non-local deployment) ---
# Razorpay dashboard -> Settings -> Webhooks -> the signing secret for your endpoint.
# If this is unset the service refuses to start unless the dev escape hatch below is set.
RAZORPAY_WEBHOOK_SECRET=

# Dev-only escape hatch. Set to 1 to accept UNVERIFIED webhooks on localhost.
# Never set this in production: it makes the endpoint an open relay for customer contact.
PUNAR_ALLOW_UNVERIFIED_WEBHOOKS=0

# --- API authentication ---
# Bearer token required by the read endpoints (/cases/{id}, /metrics).
PUNAR_API_KEY=

# --- Storage ---
# Audit trail (append-only, hash-chained). Absolute path recommended in production.
PUNAR_DB_PATH=punar_audit.db
# Learned bandit posteriors, persisted across restarts.
PUNAR_BANDIT_DB=punar_bandit.db

# --- Policy ---
# Guardrails, channels, costs, thresholds. Defaults to the packaged policy.json.
PUNAR_POLICY_PATH=

# --- Logging ---
PUNAR_LOG_LEVEL=INFO
PUNAR_LOG_FORMAT=json
